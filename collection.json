        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Dom Casmurro\",\n  \"release_year\": 1899,\n  \"author_id\": \"COLE_O_ID_DO_AUTOR_AQUI\"\n}"
        },
        "url": { "raw": "http://localhost:3000/books", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["books"] }
      }
    },
    {
      "name": "Listar Livros com Autores",
      "request": {
        "method": "GET",
        "url": { "raw": "http://localhost:3000/books", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["books"] }
      }
    },
    {
      "name": "Atualizar Livro",
      "request": {
