          "mode": "raw",
          "raw": "{\n  \"title\": \"Dom Casmurro - Edição Especial\",\n  \"release_year\": 1900\n}"
        },
        "url": { "raw": "http://localhost:3000/books/COLE_O_ID_DO_LIVRO_AQUI", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["books", "COLE_O_ID_DO_LIVRO_AQUI"] }
      }
    },
    {
      "name": "Excluir Livro",
      "request": {
        "method": "DELETE",
        "url": { "raw": "http://localhost:3000/books/COLE_O_ID_DO_LIVRO_AQUI", "protocol": "http", "host": ["localhost"], "port": "3000", "path": ["books", "COLE_O_ID_DO_LIVRO_AQUI"] }
